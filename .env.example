# Mật khẩu vào bản DEMO (khi chưa cấu hình Facebook App)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
SECRET_KEY=doi-chuoi-ngau-nhien-dai

# Facebook App (developers.facebook.com) -> Đăng nhập bằng Facebook cá nhân,
# app tự nhận diện tất cả page tài khoản đang quản lý. Để trống = chế độ DEMO.
FB_APP_ID=
FB_APP_SECRET=
BASE_URL=http://localhost:8000
FB_GRAPH_VERSION=v23.0
# Chỉ cho phép các Facebook ID này đăng nhập (để trống: người đầu tiên đăng nhập là chủ app)
ALLOWED_FB_USERS=

# Tự đọc thông tin + ảnh sản phẩm từ link Shopee (0 = tắt)
SHOPEE_FETCH=1
# (Tuỳ chọn) Shopee Affiliate Open API: dữ liệu ổn định hơn + % hoa hồng
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Google Gemini API (https://aistudio.google.com/apikey): tạo video AI bằng Veo 3.1. Để trống = giả lập, không tốn tiền.
GEMINI_API_KEY=
# veo-3.1-lite-generate-001 (rẻ nhất) | veo-3.1-generate-preview (đẹp nhất) | hoặc model Veo khác Google cung cấp
VEO_MODEL=veo-3.1-lite-generate-001
VEO_RESOLUTION=720p
VEO_SECONDS=8

# Claude API (viết caption)
ANTHROPIC_API_KEY=
# Model cho chế độ "Chất lượng cao" (chọn chế độ AI trong Cài đặt; mặc định: Tiết kiệm nhất = Haiku 4.5)
AI_MODEL=claude-opus-5
AI_EFFORT=medium
# 1 = viết bài hằng ngày qua Batch API (rẻ hơn 50%)
AI_BATCH=1
AI_BATCH_MIN=20
# Tỷ giá dùng để quy đổi chi phí ước tính
USD_VND=26000

DB_PATH=data/app.db
TIMEZONE=Asia/Ho_Chi_Minh

# ===== AI viết tiểu thuyết (python -m novel_agent) =====
# Model cho kiến trúc sư / nhà văn / biên tập viên sửa / thủ thư, và cho hội đồng phê bình
NOVEL_MODEL=claude-opus-5
NOVEL_CRITIC_MODEL=claude-opus-5
NOVEL_WRITER_EFFORT=high
NOVEL_CRITIC_EFFORT=medium
# 1 = khi model từ chối (refusal) thì API tự chạy lại trên model dự phòng
NOVEL_FALLBACKS=1
# Chương đạt khi mọi nhà phê bình chấm >= điểm này; tối đa bao nhiêu vòng sửa
NOVEL_PASS_SCORE=8
NOVEL_MAX_REVISIONS=3
NOVEL_RECENT_CHAPTERS=5
NOVEL_TAIL_CHARS=3000
NOVEL_DIR=data/novels
SCRIPT_DIR=data/scripts
